# Database
DB_URL=jdbc:postgresql://localhost:5432/zaocycle
DB_USERNAME=zaocycle
DB_PASSWORD=zaocycle

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Server
SERVER_PORT=8080

# Africa's Talking
AT_API_KEY=your_at_api_key_here
AT_USERNAME=sandbox
AT_SENDER_ID=ZAOCYCLE
AT_BASE_URL=https://api.sandbox.africastalking.com
AT_SERVICE_CODE=*384*12345#

# JWT — must be at least 32 characters
JWT_SECRET=your_jwt_secret_here_must_be_at_least_32_chars

# Daraja (M-Pesa)
DARAJA_BASE_URL=https://sandbox.safaricom.co.ke
DARAJA_CONSUMER_KEY=your_daraja_consumer_key
DARAJA_CONSUMER_SECRET=your_daraja_consumer_secret
DARAJA_SHORTCODE=600000
DARAJA_INITIATOR=testapi
DARAJA_SECURITY_CREDENTIAL=your_daraja_security_credential
DARAJA_B2C_RESULT_URL=https://example.com/mpesa/b2c/result
DARAJA_B2C_TIMEOUT_URL=https://example.com/mpesa/b2c/timeout
DARAJA_STK_PASSKEY=your_daraja_stk_passkey
DARAJA_STK_CALLBACK_URL=https://example.com/mpesa/stkpush/callback

# ZaoCycle
VERIFY_BASE_URL=https://zaocycle.app
PAYOUT_RATE_PER_KG=5.00

# Storage (DigitalOcean Spaces)
STORAGE_PROVIDER=SPACES
LOCAL_FS_BASE=./var/storage
LOCAL_FS_URL=http://localhost:8080/files
SPACES_ENDPOINT=https://sfo3.digitaloceanspaces.com
SPACES_REGION=sfo3
SPACES_BUCKET=your_spaces_bucket_name
SPACES_ACCESS_KEY=your_spaces_access_key
SPACES_SECRET_KEY=your_spaces_secret_key
